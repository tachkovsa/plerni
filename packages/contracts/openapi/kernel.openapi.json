{
  "openapi": "3.1.0",
  "info": {
    "title": "Plerni kernel API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONCURRENCY_CONFLICT",
              "RATE_LIMITED",
              "INTERNAL",
              "UNAVAILABLE",
              "UNKNOWN_EVENT_VERSION"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "next_step": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "maintenance",
              "dependency_disabled",
              "cache_unavailable",
              "parked",
              "quota"
            ]
          }
        },
        "required": [
          "code",
          "message",
          "next_step"
        ],
        "additionalProperties": false
      },
      "CreateTenantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "customer"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "CreateTenantRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,200}$"
          }
        },
        "required": [
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "NotificationPreferenceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recipientId": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "recipientId",
          "channel",
          "enabled"
        ],
        "additionalProperties": false
      },
      "NotificationPreferenceRequest": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "in_app"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "channel",
          "enabled"
        ],
        "additionalProperties": false
      },
      "NotificationSendResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,200}$"
          },
          "recipientId": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "delivered",
              "suppressed"
            ]
          }
        },
        "required": [
          "id",
          "idempotencyKey",
          "recipientId",
          "channel",
          "outcome"
        ],
        "additionalProperties": false
      },
      "NotificationSendRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,200}$"
          },
          "recipientId": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app"
            ]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "idempotencyKey",
          "recipientId",
          "channel",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/kernel/tenants": {
      "post": {
        "operationId": "kernel.tenant.create",
        "summary": "Create a customer tenant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The customer tenant. The same idempotency key returns that tenant again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTenantResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "VALIDATION"
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "FORBIDDEN"
          },
          "409": {
            "description": "CONCURRENCY_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "CONCURRENCY_CONFLICT"
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "INTERNAL"
          }
        },
        "x-plerni-action": "sensitive",
        "x-plerni-scope": "platform"
      }
    },
    "/kernel/notification-preferences": {
      "post": {
        "operationId": "kernel.notification.preference.record",
        "summary": "Record the caller preference for the in-app channel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPreferenceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The recorded preference. A later record for the same caller updates that row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPreferenceResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "VALIDATION"
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "UNAUTHENTICATED"
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "INTERNAL"
          }
        },
        "x-plerni-action": "routine",
        "x-plerni-scope": "tenant"
      }
    },
    "/kernel/notifications": {
      "post": {
        "operationId": "kernel.notification.send",
        "summary": "Deliver one notification, or return the delivery already stored for the key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSendRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The delivery for this idempotency key. A duplicate send returns that delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSendResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "VALIDATION"
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "UNAUTHENTICATED"
          },
          "403": {
            "description": "FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "FORBIDDEN"
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "NOT_FOUND"
          },
          "409": {
            "description": "CONCURRENCY_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "CONCURRENCY_CONFLICT"
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-plerni-error-code": "INTERNAL"
          }
        },
        "x-plerni-action": "routine",
        "x-plerni-scope": "tenant"
      }
    }
  },
  "webhooks": {},
  "x-plerni-error-statuses": {
    "VALIDATION": 400,
    "UNAUTHENTICATED": 401,
    "FORBIDDEN": 403,
    "NOT_FOUND": 404,
    "CONCURRENCY_CONFLICT": 409,
    "RATE_LIMITED": 429,
    "INTERNAL": 500,
    "UNAVAILABLE": 503,
    "UNKNOWN_EVENT_VERSION": 422
  }
}
