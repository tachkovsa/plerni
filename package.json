    "gate:private-markers": "node scripts/gates/private-markers.mjs",
    "gate:health": "node scripts/gates/gate-health.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
