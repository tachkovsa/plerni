{
  "name": "plerni",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gates": "pnpm run gate:licenses && pnpm run gate:kernel-purity && pnpm run gate:private-markers && pnpm run gate:health",
    "gate:licenses": "node scripts/gates/license-audit.mjs",
